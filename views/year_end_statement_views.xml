<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_year_end_statement_list" model="ir.ui.view">
        <field name="name">donation.tax.receipt.list.year.end</field>
        <field name="model">donation.tax.receipt</field>
        <field name="inherit_id" ref="donation_base.donation_tax_receipt_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="%(donation_base.tax_receipt_annual_create_action)d" type="action"
                            string="Create Statements" class="btn-primary" display="always"/>
                    <button name="action_email_statements" type="object" string="Email Statements"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="view_year_end_statement_form" model="ir.ui.view">
        <field name="name">donation.tax.receipt.form.year.end</field>
        <field name="model">donation.tax.receipt</field>
        <field name="inherit_id" ref="donation_base.donation_tax_receipt_form"/>
        <field name="arch" type="xml">
            <field name="donation_date" position="before">
                <field name="period_start_date" invisible="type != 'annual'"/>
            </field>
            <xpath expr="//sheet" position="inside">
                <notebook invisible="type != 'annual'">
                    <page string="Donations" name="donations">
                        <field name="donation_ids">
                            <list>
                                <field name="date"/>
                                <field name="name"/>
                                <field name="category_id"/>
                                <field name="amount" sum="Total"/>
                                <field name="currency_id" column_invisible="True"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="action_year_end_statement" model="ir.actions.act_window">
        <field name="name">Year-End Statements</field>
        <field name="res_model">donation.tax.receipt</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('type', '=', 'annual')]</field>
        <field name="context">{'default_type': 'annual'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create year-end giving statements</p>
            <p>Use <strong>Create Statements</strong> to make one statement per donor from the confirmed
                donations in a date range, then <strong>Email Statements</strong> to send them.</p>
        </field>
    </record>

    <record id="donation_base.tax_receipt_annual_create_action" model="ir.actions.act_window">
        <field name="name">Create Year-End Statements</field>
    </record>

    <menuitem id="menu_donation_year_end_statements" name="Year-End Statements"
              parent="menu_donation_donations" action="action_year_end_statement" sequence="30"/>

    <record id="view_company_form_year_end_statement" model="ir.ui.view">
        <field name="name">res.company.form.year.end.statement</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Donations" name="donations">
                    <group>
                        <field name="donation_statement_note"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
